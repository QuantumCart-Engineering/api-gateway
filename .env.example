NODE_ENV=development
PORT=8000

# Downstream service base URLs
IDENTITY_SERVICE_URL=http://localhost:8001
PRODUCT_SERVICE_URL=http://localhost:8002
CART_SERVICE_URL=http://localhost:8003
ORDER_SERVICE_URL=http://localhost:8004
INVENTORY_SERVICE_URL=http://localhost:8005
PAYMENT_SERVICE_URL=http://localhost:8006
CUSTOMER_SERVICE_URL=http://localhost:8007

# JWT verification (must match identity-service)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Proxy / HTTP
PROXY_TIMEOUT_MS=30000
BODY_LIMIT=1mb

# CORS (comma separated). Empty allows all origins outside production only;
# set this to the deployed storefront origin(s) in production.
ALLOWED_ORIGINS=http://localhost:4200

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=50

# Docs
SWAGGER_ENABLED=true
